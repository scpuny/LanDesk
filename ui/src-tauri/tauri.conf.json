{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanDesk",
  "version": "0.4.1",
  "identifier": "cn.landesk.app",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LanDesk",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "shortDescription": "LanDesk 局域网远程控制",
    "longDescription": "LanDesk 局域网远程控制桌面端（Tauri）。",
    "category": "Utility",
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon-512.png",
      "icons/icon-1024@2x.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "postInstallScript": "scripts/deb-postinst.sh",
        "postRemoveScript": "scripts/deb-postrm.sh"
      },
      "rpm": {
        "postInstallScript": "scripts/deb-postinst.sh",
        "postRemoveScript": "scripts/deb-postrm.sh"
      }
    }
  }
}
